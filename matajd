import tkinter as tk

class CrosshairOverlay:
    def __init__(self):
        self.root = tk.Tk()
        self.root.attributes("-topmost", True)
        self.root.attributes("-transparentcolor", "black")
        self.root.overrideredirect(True)
        self.root.configure(bg="black")

        # Fullscreen transparent window
        w = self.root.winfo_screenwidth()
        h = self.root.winfo_screenheight()
        self.root.geometry(f"{w}x{h}+0+0")

        # Crosshair list (10 total)
        self.crosshairs = [
            ("cross", "green", 25),      # 1
            ("dot", "red", 10),          # 2
            ("circle", "cyan", 30),      # 3
            ("t", "yellow", 25),         # 4
            ("vup", "orange", 30),       # 5
            ("x", "black", 25),          # 6
            ("heart", "pink", 20),       # 7
            ("triangle", "white", 30),   # 8
            ("vline", "purple", 35),     # 9
            ("star", "gold", 25)         # 0
        ]

        self.current = 0
        self.visible = True

        self.canvas = tk.Canvas(self.root, bg="black", highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)

        self.draw_crosshair()

        # Keybinds
        self.root.bind("<Key>", self.key_handler)

        self.root.mainloop()

    def key_handler(self, event):
        key = event.keysym.lower()

        if key == "q":
            self.visible = not self.visible
            self.root.attributes("-alpha", 1 if self.visible else 0)

        elif key in ["1","2","3","4","5","6","7","8","9","0"]:
            if key == "0":
                self.current = 9
            else:
                self.current = int(key) - 1
            self.draw_crosshair()

    def draw_crosshair(self):
        self.canvas.delete("all")
        w = self.root.winfo_screenwidth() // 2
        h = self.root.winfo_screenheight() // 2

        shape, color, size = self.crosshairs[self.current]

        # --- Existing shapes ---
        if shape == "cross":
            self.canvas.create_line(w - size, h, w + size, h, fill=color, width=3)
            self.canvas.create_line(w, h - size, w, h + size, fill=color, width=3)

        elif shape == "dot":
            self.canvas.create_oval(w - size, h - size, w + size, h + size,
                                    fill=color, outline=color)

        elif shape == "circle":
            self.canvas.create_oval(w - size, h - size, w + size, h + size,
                                    outline=color, width=3)

        elif shape == "t":
            self.canvas.create_line(w, h, w, h + size, fill=color, width=4)
            self.canvas.create_line(w - size//2, h, w + size//2, h, fill=color, width=4)

        elif shape == "vup":
            self.canvas.create_line(w - size, h + size, w, h - size, fill=color, width=4)
            self.canvas.create_line(w, h - size, w + size, h + size, fill=color, width=4)

        elif shape == "x":
            self.canvas.create_line(w - size, h - size, w + size, h + size, fill=color, width=4)
            self.canvas.create_line(w - size, h + size, w + size, h - size, fill=color, width=4)

        elif shape == "heart":
            self.canvas.create_arc(w - size, h - size, w, h, start=0, extent=180,
                                   style="arc", outline=color, width=3)
            self.canvas.create_arc(w, h - size, w + size, h, start=0, extent=180,
                                   style="arc", outline=color, width=3)
            self.canvas.create_polygon(
                w - size, h,
                w + size, h,
                w, h + size,
                outline=color, fill="", width=3
            )

        # --- New shapes ---
        elif shape == "triangle":
            self.canvas.create_polygon(
                w, h - size,
                w - size, h + size,
                w + size, h + size,
                outline=color, fill="", width=3
            )

        elif shape == "vline":
            self.canvas.create_line(
                w, h - size,
                w, h + size,
                fill=color, width=4
            )

        elif shape == "star":
            points = [
                w, h - size,
                w + size*0.4, h - size*0.2,
                w + size, h - size*0.2,
                w + size*0.5, h + size*0.2,
                w + size*0.7, h + size,
                w, h + size*0.5,
                w - size*0.7, h + size,
                w - size*0.5, h + size*0.2,
                w - size, h - size*0.2,
                w - size*0.4, h - size*0.2
            ]
            self.canvas.create_polygon(points, outline=color, fill="", width=3)

CrosshairOverlay()

